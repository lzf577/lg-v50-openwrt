
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/18800000.qcom,icnss'
	option country 'US'
	option country_ie '0'
	option doth '0'
	option htmode 'VHT80'
	option disassoc_low_ack '0'
	option cell_density '0'
	option band '5g'
	option channel '36'

config wifi-iface 'wifinet1'
	option device 'radio0'
	option mode 'sta'
	option network 'wwan2'
	option ssid 'YOUR_UPSTREAM_WIFI_SSID'
	option bssid '00:11:22:33:44:55'
	option encryption 'psk2'
	option key 'YOUR_WIFI_PASSWORD'
	option disabled '1'

config wifi-iface 'wifinet2'
	option device 'radio0'
	option ifname 'wlan0-1'
	option mode 'ap'
	option ssid 'LEDE'
	option network 'lan'
	option key '12345678'
	option encryption 'psk2'
	option ieee80211w '0'
	option ocv '0'
	option disassoc_low_ack '0'
	option isolate '0'
	option multicast_to_unicast '0'
	option macaddr '02:0a:f5:ea:34:ba'
